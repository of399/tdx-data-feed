# =============================================================================
# tdx-data-feed 环境变量模板
# 复制: cp .env.example .env
# 警告: .env 含密码，请勿提交到 git
# =============================================================================

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- GPU（none/all/具体数字如 1）----
NVIDIA_GPU_COUNT=all

# ---- 主应用端口 ----
TDX_WEB_PORT=8080

# ---- Ollama 推理 ----
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama:11434
OLLAMA_EXTERNAL_PORT=11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
TDX_OLLAMA_MODEL=qwen3-14b-tdx-v7
TDX_TOP_N=30
TDX_THRESHOLD=0.7

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_DB=tdx
POSTGRES_USER=tdx
POSTGRES_PASSWORD=tdx_secure_pwd_change_me

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_EXTERNAL_PORT=6379
REDIS_PASSWORD=redis_secure_pwd_change_me
REDIS_MAXMEMORY=2gb

# ---- Prometheus ----
PROMETHEUS_EXTERNAL_PORT=9090

# ---- Grafana ----
GRAFANA_EXTERNAL_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana_secure_pwd_change_me

# ---- 构建参数 ----
LLAMA_CPP_REF=master
SKIP_OLLAMA_PULL=false