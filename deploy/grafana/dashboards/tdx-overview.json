{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "enable": true,
        "iconColor": "rgba(255, 96, 96, 1)",
        "name": "部署事件",
        "tags": ["deploy", "release"],
        "type": "tags"
      }
    ]
  },
  "description": "tdx-data-feed 量化研究平台核心监控仪表板（预测分布 + 推理延迟 + 回测胜率）",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Prometheus", "url": "http://localhost:9090", "type": "link", "icon": "external link", "targetBlank": true},
    {"title": "Ollama API", "url": "http://localhost:11434", "type": "link", "icon": "external link", "targetBlank": true},
    {"title": "tdx-app", "url": "http://localhost:8080", "type": "link", "icon": "external link", "targetBlank": true}
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "📊 监控总览",
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=~\"tdx-app|ollama|postgres|redis\"} == 1)",
          "legendFormat": "在线服务"
        },
        {
          "refId": "B",
          "expr": "count(up{job=~\"tdx-app|ollama|postgres|redis\"} == 0)",
          "legendFormat": "离线服务"
        },
        {
          "refId": "C",
          "expr": "tdx_predictions_total_count",
          "legendFormat": "今日预测数"
        },
        {
          "refId": "D",
          "expr": "tdx_predictions_high_prob_count",
          "legendFormat": "高分预测"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "离线服务"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}]}
        ]
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "🎯 预测分布",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 6}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "每日预测总数 + 高分预测（概率≥0.7）",
      "description": "展示每日全市场预测数量及触发高分阈值的数量",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 7},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "expr": "tdx_predictions_total_count",
          "legendFormat": "全市场预测",
          "interval": "1d"
        },
        {
          "refId": "B",
          "expr": "tdx_predictions_high_prob_count",
          "legendFormat": "高分(≥0.7)",
          "interval": "1d"
        },
        {
          "refId": "C",
          "expr": "tdx_predictions_high_prob_count / clamp_min(tdx_predictions_total_count, 1)",
          "legendFormat": "高分占比",
          "interval": "1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {"mode": "none"}
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "高分占比"}, "properties": [
            {"id": "unit", "value": "percentunit"},
            {"id": "custom.fillOpacity", "value": 5},
            {"id": "custom.lineWidth", "value": 2}
          ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 12,
      "type": "histogram",
      "title": "预测概率分布（直方图）",
      "description": "今日全市场预测概率的分布情况",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 7},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "expr": "tdx_prediction_prob_bucket",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ],
      "options": {
        "color": {"mode": "scheme", "scheme": "Spectral", "exponent": 0.5, "fill": "dark-orange", "scale": "exponential", "steps": 64, "reverse": false},
        "calculate": false,
        "yAxis": {"axisPlacement": "left", "unit": "short", "decimals": 0},
        "tooltip": {"mode": "single", "sort": "none"},
        "legend": {"showLegend": false},
        "exemplars": {"color": "rgba(255,0,255,0.7)"},
        "filterValues": {"le": 1e-9},
        "rowsFrame": {"layout": "auto"}
      }
    },
    {
      "id": 13,
      "type": "bargauge",
      "title": "Top 10 高分预测股票",
      "description": "按概率排序的 Top 10 候选股",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, tdx_prediction_prob_by_code)",
          "legendFormat": "{{code}}",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.6},
              {"color": "orange", "value": 0.75},
              {"color": "red", "value": 0.9}
            ]
          },
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "高分预测触发阈值统计",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "tdx_predictions_above_0_9", "legendFormat": "≥ 0.9"},
        {"refId": "B", "expr": "tdx_predictions_above_0_8", "legendFormat": "≥ 0.8"},
        {"refId": "C", "expr": "tdx_predictions_above_0_7", "legendFormat": "≥ 0.7"},
        {"refId": "D", "expr": "tdx_predictions_above_0_6", "legendFormat": "≥ 0.6"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "wideLayout": false,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "dark-green", "value": null},
              {"color": "green", "value": 50},
              {"color": "yellow", "value": 500},
              {"color": "red", "value": 2000}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "⏱️ 模型推理延迟",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Ollama 推理延迟 (P50/P95/P99)",
      "description": "每次推理请求的响应时间分布",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "histogram_quantile(0.50, sum(rate(ollama_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P50"},
        {"refId": "B", "expr": "histogram_quantile(0.95, sum(rate(ollama_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P95"},
        {"refId": "C", "expr": "histogram_quantile(0.99, sum(rate(ollama_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "P99"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never"},
          "unit": "s",
          "min": 0
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "P50"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
          {"matcher": {"id": "byName", "options": "P95"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]},
          {"matcher": {"id": "byName", "options": "P99"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "推理吞吐量 (req/s) + Token 速率",
      "description": "每秒钟推理请求数与生成的 token 速率",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "rate(ollama_requests_total[1m])", "legendFormat": "请求/秒"},
        {"refId": "B", "expr": "rate(ollama_tokens_generated_total[1m])", "legendFormat": "tokens/秒"},
        {"refId": "C", "expr": "rate(ollama_tokens_prompt_total[1m])", "legendFormat": "prompt tokens/秒"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15, "showPoints": "auto"},
          "unit": "ops"
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max", "mean"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Ollama 当前模型加载",
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "ollama_loaded_models_count", "legendFormat": "已加载"},
        {"refId": "B", "expr": "ollama_max_loaded_models", "legendFormat": "上限"},
        {"refId": "C", "expr": "ollama_gpu_memory_used_bytes / 1024 / 1024 / 1024", "legendFormat": "GPU显存(GB)"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 20},
              {"color": "red", "value": 28}
            ]
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background"
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "推理错误率 (5xx / 总请求)",
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 32},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "sum(rate(ollama_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(ollama_requests_total[5m])), 0.001)", "legendFormat": "5xx 错误率"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 25,
      "type": "gauge",
      "title": "GPU 利用率",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 32},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "100 - (avg by (instance) (rate(node_gpu_utilization_idle_seconds[1m])) * 100)", "legendFormat": "GPU利用率"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 50},
              {"color": "red", "value": 85}
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 30,
      "type": "row",
      "title": "📈 回测胜率趋势",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36}
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "方案 E 每日回测胜率 (含对比)",
      "description": "v1 旧规则 vs v2 增强版（T+1≥9.5% + 量比）",
      "gridPos": {"h": 8, "w": 16, "x": 0, "y": 37},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "tdx_backtest_win_rate{strategy=\"plan_e_v2\"}", "legendFormat": "v2 增强版 (当前)"},
        {"refId": "B", "expr": "tdx_backtest_win_rate{strategy=\"plan_e_v1\"}", "legendFormat": "v1 旧规则"},
        {"refId": "C", "expr": "avg_over_time(tdx_backtest_win_rate{strategy=\"plan_e_v2\"}[7d])", "legendFormat": "v2 7日均线"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto", "spanNulls": true},
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": [
          {"matcher": {"id": "byName", "options": "v2 增强版 (当前)"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "light-blue"}}
          ]},
          {"matcher": {"id": "byName", "options": "v2 7日均线"}, "properties": [
            {"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}},
            {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}},
            {"id": "custom.lineWidth", "value": 3}
          ]}
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "mean", "max", "min"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "thresholds": [
        {"value": 0.4, "op": "gt", "colorMode": "warning", "fill": false, "line": true, "yaxis": "left"},
        {"value": 0.55, "op": "gt", "colorMode": "ok", "fill": false, "line": true, "yaxis": "left"}
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "回测核心指标",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 37},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "tdx_backtest_avg_return{strategy=\"plan_e_v2\"}", "legendFormat": "平均收益"},
        {"refId": "B", "expr": "tdx_backtest_profit_loss_ratio{strategy=\"plan_e_v2\"}", "legendFormat": "盈亏比"},
        {"refId": "C", "expr": "tdx_backtest_total_signals{strategy=\"plan_e_v2\"}", "legendFormat": "总信号"},
        {"refId": "D", "expr": "tdx_backtest_sharpe_ratio{strategy=\"plan_e_v2\"}", "legendFormat": "夏普比率"}
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "orientation": "vertical",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0},
              {"color": "green", "value": 0.05}
            ]
          },
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "回测累计收益曲线",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 45},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "tdx_backtest_cumulative_return{strategy=\"plan_e_v2\"}", "legendFormat": "累计收益 v2"},
        {"refId": "B", "expr": "tdx_backtest_cumulative_return{strategy=\"plan_e_v1\"}", "legendFormat": "累计收益 v1"},
        {"refId": "C", "expr": "tdx_backtest_benchmark_cumulative_return", "legendFormat": "基准 (沪深300)"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never"},
          "unit": "percentunit"
        }
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "mean"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 34,
      "type": "table",
      "title": "最近 10 次回测结果明细",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 53},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {
          "refId": "A",
          "expr": "tdx_backtest_results",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {"id": "organize", "options": {
          "indexByName": {
            "Time": 0, "run_date": 1, "strategy": 2, "total_signals": 3,
            "wins": 4, "losses": 5, "avg_return": 6, "win_rate": 7
          },
          "renameByName": {
            "run_date": "日期", "strategy": "策略", "total_signals": "信号数",
            "wins": "盈利", "losses": "亏损", "avg_return": "平均收益", "win_rate": "胜率"
          }
        }}
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{"displayName": "日期", "desc": true}],
        "pageSize": 10
      }
    },
    {
      "id": 40,
      "type": "row",
      "title": "🖥️ 系统资源",
      "collapsed": true,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 61}
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "主机 CPU / 内存 / 磁盘",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 62},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU使用率"},
        {"refId": "B", "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "内存使用率"},
        {"refId": "C", "expr": "(1 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})) * 100", "legendFormat": "磁盘使用率"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "PostgreSQL / Redis 关键指标",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 62},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"refId": "A", "expr": "pg_stat_activity_count", "legendFormat": "PG连接数"},
        {"refId": "B", "expr": "rate(pg_stat_database_tup_fetched{datname=\"tdx\"}[5m])", "legendFormat": "PG读取行/s"},
        {"refId": "C", "expr": "redis_used_memory_bytes / 1024 / 1024 / 1024", "legendFormat": "Redis内存(GB)"},
