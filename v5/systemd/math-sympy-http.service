[Unit]
Description=v5-VE1 Math SymPy FastAPI Server (D6.6)
After=network.target
Wants=network.target

[Service]
Type=simple
User=jiuben
WorkingDirectory=/home/jiuben/tdx-data-feed
# venv-math 而非 venv：sympy 1.14 的 parse_latex 要 antlr4 4.11，主 venv 的 4.9.3 被
# omegaconf(llamafactory) 锁死。详见 v5/requirements-math.txt。PATH 首位也必须是 venv-math，
# 否则服务里起的子进程 `python` 仍会解析回主 venv。
Environment="PATH=/home/jiuben/tdx-data-feed/venv-math/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="OLLAMA_URL=http://127.0.0.1:11434"
Environment="DEFAULT_CHAT_MODEL=qwen3:14b"
Environment="DEFAULT_REASON_MODEL=deepseek-r1:14b"
Environment="DEFAULT_EMBED_MODEL=nomic-embed-text:latest"
Environment="DEFAULT_JUDGE_MODEL=qwen3-14b-tdx-fast:14b"
ExecStart=/home/jiuben/tdx-data-feed/venv-math/bin/python \
    /home/jiuben/tdx-data-feed/v5/mcp_servers/math_sympy_http.py \
    --host 127.0.0.1 --port 8002 --workers 1
Restart=always
RestartSec=3
StandardOutput=append:/var/log/math-sympy-http.log
StandardError=append:/var/log/math-sympy-http.err
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
