{
  "version": "2.0.0",
  "settings": {
    "commitMessage": "vault: {{date}} {{hostname}}",
    "autoCommit": false,
    "autoPush": false,
    "autoPull": false,
    "disablePush": true,
    "commitOnClose": false,
    "syncMethod": "merge",
    "refreshSourceControl": true,
    "differentInterval": 10,
    "autoSaveInterval": 30,
    "lineAuthor": {
      "enable": false
    },
    "showDiffStyle": "git",
    "updateSubmodules": false,
    "excludePatterns": [
      ""
    ],
    "listChangedFilesInMessageBody": false
  }
}
