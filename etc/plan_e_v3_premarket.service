ExecStart=/home/jiuben/tdx-data-feed/venv/bin/python /home/jiuben/tdx-data-feed/scripts/v3_premarket_top.py
StandardOutput=append:/home/jiuben/tdx-data-feed/data/plan_e/live_v3/premarket.log
