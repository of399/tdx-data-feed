#!/bin/bash
# trainsh — 一键查训练进度（无需 login venv）
# 安装：sudo cp /home/jiuben/tdx-data-feed/scripts/trainsh /usr/local/bin/trainsh
# 用法：
#   trainsh              # 进度概览（默认）
#   trainsh -l           # tail train.log
#   trainsh -g           # nvidia-smi
#   trainsh -p           # 画 loss PNG
#   trainsh -k           # 优雅 kill 训练
#   trainsh -w [N]       # 实时刷新（默认 5s）
#   trainsh -h           # 帮助

set -euo pipefail

# 默认监控 v7 旧任务(qwen3-14b-tdx / tdx_lora.yaml)，行为不变。
# 切换任务用环境变量，例如 v9 双卡训练：
#   export TDX_TRAIN_CFG=tdx_v9_from_scratch.yaml
#   export TDX_OUT_DIR=/home/jiuben/tdx-data-feed/train/output/qwen3-14b-tdx-v9
#   trainsh -w 5          # 实时进度
#   trainsh -k            # 优雅停止(匹配该 CFG 的全部进程: wrapper+launcher+2 worker)
# 可选 TDX_LOG 指定 tail -l 查看的日志(默认 $OUT_DIR/train.log)
VENV_PY="/home/jiuben/tdx-data-feed/venv/bin/python"
TDX_TRAIN_CFG="${TDX_TRAIN_CFG:-tdx_lora.yaml}"
OUT_DIR="${TDX_OUT_DIR:-/home/jiuben/tdx-data-feed/train/output/qwen3-14b-tdx}"
JSONL="$OUT_DIR/trainer_log.jsonl"
LOG="${TDX_LOG:-$OUT_DIR/train.log}"

usage() {
    sed -n '2,12p' "$0"
    exit 0
}

status() {
    TDX_OUT_DIR="$OUT_DIR" TDX_TRAIN_CFG="$TDX_TRAIN_CFG" "$VENV_PY" << 'PYEOF'
import json, os, sys
from datetime import datetime

OUT_DIR = os.environ.get("TDX_OUT_DIR", "/home/jiuben/tdx-data-feed/train/output/qwen3-14b-tdx")
JSONL = os.path.join(OUT_DIR, "trainer_log.jsonl")
CFG = os.environ.get("TDX_TRAIN_CFG", "tdx_lora.yaml")

# 找训练进程(匹配 llamafactory-cli + torchrun launcher + worker)
import subprocess
ps = subprocess.run(["pgrep", "-af", CFG], capture_output=True, text=True)
pid_lines = [l for l in ps.stdout.strip().split('\n') if l.strip()]
print(f"=== 训练状态 [{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] ===")
print(f"  PID:          {pid_lines[0] if pid_lines else '—'}  (匹配进程 {len(pid_lines)} 个)")

# 读 jsonl
if not os.path.exists(JSONL):
    print(f"  状态:         初始化中（trainer_log.jsonl 未生成）")
    sys.exit(0)

with open(JSONL) as f:
    lines = [json.loads(l) for l in f if l.strip()]
if not lines:
    print(f"  状态:         初始化中")
    sys.exit(0)

train_recs = [l for l in lines if "loss" in l]
eval_recs = [l for l in lines if "eval_loss" in l]

if not train_recs:
    # 尚未开始训练 step(初始 eval 阶段, jsonl 里只有 eval 记录, 无 loss 键)
    print(f"  阶段:         初始评估中(尚未开始训练 step)")
    if eval_recs:
        ev = eval_recs[-1]
        print(f"  eval_loss:    {ev.get('eval_loss'):.4f}")
        print(f"  eval 进度:    {ev.get('current_steps','?')} / {ev.get('total_steps','?')}")
    sys.exit(0)

last = train_recs[-1]
pct = last.get("percentage", 0.0)
cur = last.get("current_steps", 0)
total = last.get("total_steps", 0)
loss = last["loss"]
lr = last.get("lr", 0)
epoch = last.get("epoch", 0)
rem_str = last.get("remaining_time", "?")

# 计算 ETA
try:
    days, hms = rem_str.split(", ", 1) if ", " in rem_str else ("0", rem_str)
    days = int(days.split(" ")[0])
    h, m_, s = [float(x) for x in hms.split(":")]
    eta_sec = days * 86400 + h * 3600 + m_ * 60 + s
    eta = (datetime.now().timestamp() + eta_sec)
    eta_str = datetime.fromtimestamp(eta).strftime("%Y-%m-%d %H:%M")
except Exception:
    eta_str = "?"

print(f"  进度:         {cur} / {total} ({pct:.2f}%)")
print(f"  epoch:        {epoch:.3f}")
print(f"  loss:         {loss:.4f}")
print(f"  lr:           {lr:.2e}")
print(f"  剩余:         {rem_str}")
print(f"  ETA:          ~{eta_str}")
if eval_recs:
    print(f"  eval_loss:    {eval_recs[-1].get('eval_loss'):.4f}")

# 5 步 trend
if len(train_recs) >= 5:
    losses = [l_["loss"] for l_ in train_recs[-5:]]
    trend = losses[-1] - losses[0]
    arrow = "↓" if trend < 0 else ("↑" if trend > 0 else "→")
    print(f"  5 步趋势:    {arrow} {trend:+.4f}  ({losses[0]:.4f} → {losses[-1]:.4f})")

# checkpoint 数
ckpts = sorted([d for d in os.listdir(OUT_DIR) if d.startswith("checkpoint-")])
print(f"  checkpoints: {len(ckpts)} 个")
if ckpts:
    for c in ckpts[-3:]:
        size = sum(os.path.getsize(os.path.join(OUT_DIR, c, f))
                   for f in os.listdir(os.path.join(OUT_DIR, c))
                   if os.path.isfile(os.path.join(OUT_DIR, c, f)))
        print(f"    {c}  ({size / 1e6:.1f} MB)")
PYEOF
}

gpu() {
    nvidia-smi --query-gpu=index,utilization.gpu,memory.used,memory.total,temperature.gpu \
        --format=csv 2>&1 | head -3
}

plot() {
    "$VENV_PY" /home/jiuben/tdx-data-feed/scripts/plot_loss.py 2>&1
}

kill_train() {
    local pid
    pid=$(pgrep -f "$TDX_TRAIN_CFG" | head -1 || true)
    if [ -z "$pid" ]; then
        echo "✗ 没有匹配 $TDX_TRAIN_CFG 的训练进程"
        exit 1
    fi
    echo "优雅 kill (匹配 $TDX_TRAIN_CFG): TERM → 等 15s → KILL"
    pkill -TERM -f "$TDX_TRAIN_CFG" || true
    sleep 15
    if pgrep -f "$TDX_TRAIN_CFG" > /dev/null 2>&1; then
        pkill -KILL -f "$TDX_TRAIN_CFG" || true
        echo "✓ 强 KILL 完成"
    else
        echo "✓ SIGTERM 优雅退出"
    fi
}

watch() {
    local interval=${1:-5}
    while true; do
        clear
        status
        echo ""
        echo "(刷新 ${interval}s, Ctrl-C 退出)"
        sleep "$interval"
    done
}

case "${1:-status}" in
    -h|--help|help) usage ;;
    -l|--log) tail -f "$LOG" ;;
    -g|--gpu) gpu ;;
    -p|--plot) plot ;;
    -k|--kill) kill_train ;;
    -w|--watch) watch "${2:-5}" ;;
    status|"") status ;;
    *) echo "未知参数: $1"; usage ;;
esac
