[Unit]
Description=Canary 健康检查（每 5 分钟）
# 它是告警员，自己静默崩掉最没人知道；每 5 分钟一次所以靠脚本的 1 小时冷却压重复
OnFailure=onfailure-alert@canary-health.service

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
Environment="PATH=@TDX_HOME@/venv/bin:/usr/local/bin:/usr/bin:/bin"
# 每 5 分钟一次的健康巡检，正常 <10s；超时上限给到 120s 防止与数据目录 IO 争抢时误杀。
TimeoutStartSec=120
ExecStart=@TDX_HOME@/venv/bin/python scripts/canary_health_check.py --quiet
StandardOutput=append:@TDX_HOME@/logs/canary.out
StandardError=append:@TDX_HOME@/logs/canary.err
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
