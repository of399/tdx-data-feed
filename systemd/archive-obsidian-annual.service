[Unit]
Description=Archive Obsidian reports from previous year to 08-报告/archive/YYYY.zip
Documentation=file://@TDX_HOME@/docs/archive/obsidian_upgrade_plan_20261015.md
After=network.target
OnFailure=onfailure-alert@archive-obsidian-annual.service

[Service]
Type=oneshot
# 用 /bin/bash 显式调用，避免脚本需要 +x
ExecStart=/bin/bash @TDX_HOME@/scripts/archive_obsidian_annual.sh
StandardOutput=append:@TDX_HOME@/logs/archive-obsidian-annual.log
StandardError=append:@TDX_HOME@/logs/archive-obsidian-annual.log
# 失败不重试（oncalendar 持久化会补跑）
Restart=no
