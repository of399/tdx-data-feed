[Unit]
Description=tdx-data-feed: 全市场日K + 财务增量同步
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/jiuben/tdx-data-feed
Environment="PATH=/home/jiuben/tdx-data-feed/venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/jiuben/tdx-data-feed/venv/bin/python -m tdxfeed.cli sync
StandardOutput=append:/home/jiuben/tdx-data-feed/logs/sync.log
StandardError=append:/home/jiuben/tdx-data-feed/logs/sync.err
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
