[Unit]
Description=方案 E 实盘样本·定期回溯调优（journal 回灌 + retune/by-year/real）
OnFailure=onfailure-alert@plan-e-real-refresh.service

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
Environment="PATH=@TDX_HOME@/venv/bin:/usr/local/bin:/usr/bin:/bin"
# 数据新鲜度守卫
ExecStartPre=@TDX_HOME@/scripts/precheck_freshness.sh
ExecStart=@TDX_HOME@/scripts/plan_e_real_refresh.sh
StandardOutput=append:@TDX_HOME@/logs/plan_e_real_refresh.log
StandardError=append:@TDX_HOME@/logs/plan_e_real_refresh.err
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=timers.target
