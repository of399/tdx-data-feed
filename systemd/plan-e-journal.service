[Unit]
Description=方案 E 每日信号归档（18:10 在 predict-daily 之后）
After=predict-daily.service
Wants=predict-daily.service
OnFailure=onfailure-alert@plan-e-journal.service

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
Environment="PATH=@TDX_HOME@/venv/bin:/usr/local/bin:/usr/bin:/bin"
# 数据新鲜度守卫
ExecStartPre=@TDX_HOME@/scripts/precheck_freshness.sh
# 盘后信号归档，量级接近 predict；与 predict 保持一致的超时上限。
TimeoutStartSec=1800
ExecStart=@TDX_HOME@/venv/bin/python scripts/plan_e_journal.py --mode daily
StandardOutput=append:@TDX_HOME@/logs/plan_e_journal.log
StandardError=append:@TDX_HOME@/logs/plan_e_journal.err
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=timers.target
