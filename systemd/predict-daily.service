[Unit]
Description=方案 D 每日预测：收盘后跑全市场 daban 29 维特征 + LightGBM 推理（小仓位 Top5）
# 每日同步只有一个调度源：系统级 tdx-sync.timer（16:30）。用户级 tdxfeed-sync.timer 已于
# 2026-10-28 退役，本单元不再 Requires=/After= 它——两个都挂就是每晚两遍全市场同步。
# 数据是否到位改由 ExecStartPre 的新鲜度守卫兜底：同步没跑成，precheck_freshness.sh
# 以 exit 2 拦下预测整轮，OnFailure 负责喊人（日志不是告警）。
OnFailure=onfailure-alert@predict-daily.service

[Service]
Type=oneshot
WorkingDirectory=/home/jiuben/tdx-data-feed
Environment="PATH=/home/jiuben/tdx-data-feed/venv/bin:/usr/local/bin:/usr/bin:/bin"
# 数据新鲜度守卫：50 抽样中 >20% 末日期早于 today-2d 则 exit 2，主 ExecStart 不执行
ExecStartPre=/home/jiuben/tdx-data-feed/scripts/precheck_freshness.sh
# small 模式默认 Top 5；阈值 0.7，并行 8 进程（避免内存爆）
ExecStart=/home/jiuben/tdx-data-feed/venv/bin/python scripts/predict.py --position-mode small --threshold 0.7 --workers 8
StandardOutput=append:/home/jiuben/tdx-data-feed/logs/predict.log
StandardError=append:/home/jiuben/tdx-data-feed/logs/predict.err
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=timers.target
