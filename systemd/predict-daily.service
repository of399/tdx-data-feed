[Unit]
Description=方案 D 每日预测：收盘后跑全市场 daban 29 维特征 + LightGBM 推理（小仓位 Top5）
# 每日同步只有一个调度源：系统级 tdx-sync.timer（16:30）。用户级 tdxfeed-sync.timer 已于
# 2026-10-28 退役，本单元不再 Requires=/After= 它——两个都挂就是每晚两遍全市场同步。
# 数据是否到位改由 ExecStartPre 的新鲜度守卫兜底：同步没跑成，precheck_freshness.sh
# 以 exit 2 拦下预测整轮，OnFailure 负责喊人（日志不是告警）。
OnFailure=onfailure-alert@predict-daily.service

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
Environment="PATH=@TDX_HOME@/venv/bin:/usr/local/bin:/usr/bin:/bin"
# 数据新鲜度守卫：50 抽样中 >20% 末日期早于 today-2d 则 exit 2，主 ExecStart 不执行
ExecStartPre=@TDX_HOME@/scripts/precheck_freshness.sh
# 同步完成哨兵（KI-COMPETE-001）：本交易日全市场同步未完成则不出榜（与上面整体陈旧守卫互补，
# 挡住"部分标的正在被写"的并发竞态）。哨兵缺失/过期 => exit 2。双通道（unit 近期 success 兜底首次上线）。
ExecStartPre=@TDX_HOME@/venv/bin/python @TDX_HOME@/scripts/check_sync_sentinel.py --max-age-hours 12
# small 模式默认 Top 5；阈值 0.7，并行 8 进程（避免内存爆）
# 全市场 5221 只 × 8 进程，量级远超 user manager 默认 90s；避免卡死时占住机器数小时。
TimeoutStartSec=1800
ExecStart=@TDX_HOME@/venv/bin/python scripts/predict.py --position-mode small --threshold 0.7 --workers 8
StandardOutput=append:@TDX_HOME@/logs/predict.log
StandardError=append:@TDX_HOME@/logs/predict.err
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=timers.target
