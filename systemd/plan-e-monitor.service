[Unit]
Description=Plan E 实盘监控（真实 PnL 跟踪与偏差分析）
Documentation=file://@TDX_HOME@/scripts/monitor_plan_e_live.py file://@TDX_HOME@/docs/PLAN_E_LIVE.md
OnFailure=onfailure-alert@plan-e-monitor.service

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
ExecStart=@TDX_HOME@/venv/bin/python scripts/monitor_plan_e_live.py --emit auto
StandardOutput=append:@TDX_HOME@/logs/plan-e-monitor.out
StandardError=append:@TDX_HOME@/logs/plan-e-monitor.err
