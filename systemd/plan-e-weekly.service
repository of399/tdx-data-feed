[Unit]
Description=方案 E 周报生成（每周五 20:00）
OnFailure=onfailure-alert@plan-e-weekly.service

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
Environment="PATH=@TDX_HOME@/venv/bin:/usr/local/bin:/usr/bin:/bin"
# 数据新鲜度守卫
ExecStartPre=@TDX_HOME@/scripts/precheck_freshness.sh
ExecStart=@TDX_HOME@/venv/bin/python scripts/plan_e_journal.py --mode weekly
StandardOutput=append:@TDX_HOME@/logs/plan_e_weekly.log
StandardError=append:@TDX_HOME@/logs/plan_e_weekly.err
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=timers.target
