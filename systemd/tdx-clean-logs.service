[Unit]
Description=tdx-data-feed 旧日志清理（保留最近 7 天）
# 手动跑同一个清理：make clean-logs
Documentation=file://@TDX_HOME@/docs/WORKFLOW.md
OnFailure=onfailure-alert@tdx-clean-logs.service

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
# clean-logs 委托 scripts/clean_logs.py：删 >7 天旧文件 + 截断超 8MB 的追加日志
ExecStart=/usr/bin/make -C @TDX_HOME@ clean-logs
StandardOutput=append:@TDX_HOME@/logs/tdx-clean-logs.log
StandardError=append:@TDX_HOME@/logs/tdx-clean-logs.err
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=timers.target
