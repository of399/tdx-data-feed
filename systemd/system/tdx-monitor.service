[Unit]
Description=tdx System Monitor (CPU/GPU/Disk/Services health)
OnFailure=onfailure-alert-system@tdx-monitor.service
Documentation=v5-implementation-plan.md §4.2 M4
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
ExecStart=@TDX_HOME@/venv/bin/python @TDX_HOME@/v5/scripts/tdx_monitor.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tdx-monitor
User=jiuben

[Install]
WantedBy=multi-user.target
