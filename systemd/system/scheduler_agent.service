[Unit]
Description=M5 Vault 5 Agent Scheduler (smart dispatch per cycle)
Documentation=file://@TDX_HOME@/v5-implementation-plan.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
ExecStart=@TDX_HOME@/venv/bin/python @TDX_HOME@/v5/scripts/scheduler_agent.py --once
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scheduler-agent
User=jiuben
Group=jiuben
Environment="V5_DIR=@TDX_HOME@/v5"
Environment="VAULT_PATH=/home/jiuben/StockVault"

[Install]
WantedBy=multi-user.target
