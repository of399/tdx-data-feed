[Unit]
Description=tdx Verification (run math_sympy tests + smoke test)
OnFailure=onfailure-alert-system@tdx-verification.service
Documentation=v5-implementation-plan.md §4.2 M4

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
ExecStart=@TDX_HOME@/venv/bin/python @TDX_HOME@/v5/scripts/tdx_verification.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tdx-verification
User=jiuben

[Install]
WantedBy=multi-user.target
