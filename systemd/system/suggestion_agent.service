[Unit]
Description=Vault Suggestion Agent (M5 Phase 2 简化版：linking + tag + moc + promotion)
Documentation=file://@TDX_HOME@/v5-implementation-plan.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jiuben
WorkingDirectory=@TDX_HOME@
ExecStart=@TDX_HOME@/venv/bin/python @TDX_HOME@/v5/scripts/suggestion_agent.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=suggestion_agent
# 不让失败阻塞下次触发
SuccessExitStatus=0 1
