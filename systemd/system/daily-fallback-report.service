[Unit]
Description=Daily Fallback Report Generator
Documentation=man:systemd.service

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
ExecStart=@TDX_HOME@/venv/bin/python @TDX_HOME@/v5/scripts/daily_fallback_report.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fallback-daily-report
User=jiuben
Group=jiuben
Environment="MATH_AUDIT_DIR=@TDX_HOME@/v5/audit"
Environment="REPORT_DIR=@TDX_HOME@/v5/reports"

[Install]
WantedBy=multi-user.target
