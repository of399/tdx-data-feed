[Unit]
Description=Audit Log Rotation & TTL Cleanup
Documentation=v5-implementation-plan.md §4.2 M3 W6

[Service]
Type=oneshot
WorkingDirectory=@TDX_HOME@
ExecStart=@TDX_HOME@/venv/bin/python @TDX_HOME@/v5/scripts/audit_log_rotate.py --keep-days 30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=audit-log-rotate
User=jiuben
Group=jiuben
Environment="MATH_AUDIT_DIR=@TDX_HOME@/v5/audit"

[Install]
WantedBy=multi-user.target
