[Unit]
Description=TDX Data Feed Daily Incremental Sync (full_market)
OnFailure=onfailure-alert-system@tdx-sync.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jiuben
WorkingDirectory=@TDX_HOME@
ExecStart=@TDX_HOME@/venv/bin/python -m tdxfeed.full_sync
# 同步完成哨兵（KI-COMPETE-001）：full_sync 成功（exit 0）才执行 ExecStartPost；
# 失败则整条 ExecStartPost 链不执行 => 哨兵不写。predict-daily 据此门禁出榜。
ExecStartPost=@TDX_HOME@/venv/bin/python @TDX_HOME@/scripts/mark_sync_done.py
# 同步成功后刷新派生表、复权因子与后复权因子（增量）。前缀 "-" 表示后置任务失败不把整轮同步判红：
# 数据是否真的新鲜由 canary 的 data_files 检查兜底，避免一次网络抖动让整个同步单元变红。
ExecStartPost=-@TDX_HOME@/venv/bin/python -m tdxfeed.precompute.indicators --incremental
ExecStartPost=-@TDX_HOME@/venv/bin/python -m tdxfeed.adj_factor
ExecStartPost=-@TDX_HOME@/venv/bin/python -m tdxfeed.hfq_factor
StandardOutput=append:@TDX_HOME@/logs/tdx-systemd.log
StandardError=append:@TDX_HOME@/logs/tdx-systemd.log
# 预算按 2026-11 三个交易日的实测串行墙钟重排。旧注释写的"adj / hfq 全市场各约 60 分钟"
# 已被否证，实际数是 122–128 分钟（5221 只逐只打 baostock，除权日还要整表重拉）：
#   full_sync   40 分钟（11-02）→ 73 分钟（11-04）
#   indicators   1.1 分钟（11-02）→ 3.7 分钟（11-03）→ 2.0 分钟（11-04）
#   adj_factor 122.6 分钟（11-02，rebase=61）/ 124.9 分钟（11-04，rebase=50）
#   hfq_factor 128 分钟（11-02，19:14:46 → 21:22:51）
#   整轮 journal 记账：11-02 = 4h51m59s，11-03 = 5h19m20s（都是跑完的）
# 取各任务实测最坏值并向上取整（90 + 10 + 150 + 150 = 400 分钟 ≈ 6h40m），再给
# baostock 会话重连（单轮上限 30 次）留退避余量 → 8 小时。
# 原来的 6 小时在 11-04 只剩不到 30 分钟余量：任一环节变慢就会被 TimeoutStartSec 截断，
# 而截断时后半段没有任何完成标记，`-` 前缀还会把单元记成 Finished——所以 6 小时不是
# "安全上限"，是"跑完刚好没余量"。也别压回 3 小时（源变慢时会把 oneshot 拖到被杀）。
# 下一档触发点是次日 16:30，8 小时最晚到 00:30，不会与下一轮撞车。
TimeoutStartSec=28800
